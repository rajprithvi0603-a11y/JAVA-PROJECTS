class TicketBooking { String name, status; TicketBooking(String n, String s) { name = n; status = s; } void display() {  System.out.println(name + " " + status + " "   + Thread.currentThread().getName()); } } class BookingThread extends Thread { TicketBooking tb; BookingThread(TicketBooking tb, String n) { super(n); this.tb = tb; } public void run() { tb.display(); } } class BookingRunnable implements Runnable { TicketBooking tb; BookingRunnable(TicketBooking tb) { this.tb = tb; } public void run() { tb.display(); } } public class P8 { public static void main(String[] a) throws InterruptedException {  Thread t1 = new BookingThread(   new TicketBooking("Rahul","Booked"), "T-A");  Thread t2 = new BookingThread(   new TicketBooking("Priya","Done"), "T-B");  Thread t3 = new Thread(new BookingRunnable(   new TicketBooking("Amit","Booked")), "T-C");  Thread t4 = new Thread(new BookingRunnable(   new TicketBooking("Sneha","Done")), "T-D");  t1.start(); t2.start(); t3.start(); t4.start();  t1.join(); t2.join(); t3.join(); t4.join();  System.out.println("All bookings processed."); } }
