PRACTICUM 4 class Payment { void makePayment(double a) { System.out.println("Payment Rs." + a); } void makePayment(double a, String id) {  System.out.println("Payment Rs." + a + " TxnID: " + id); } } class CreditCardPayment extends Payment { @Override void makePayment(double a) {  System.out.println("Credit Card Rs." + a); } } class UPIPayment extends Payment { @Override void makePayment(double a) {  System.out.println("UPI Rs." + a); } } class NetBankingPayment extends Payment { @Override void makePayment(double a) {  System.out.println("Net Banking Rs." + a); } } public class P4 { public static void main(String[] args) {  Payment p = new CreditCardPayment();  p.makePayment(5000);  p.makePayment(2500, "TXN1001");  p = new UPIPayment();  p.makePayment(1200.50);  p = new NetBankingPayment();  p.makePayment(8500); } }
