class BankAccount {
    String name, type;
    int number;
    double balance;

    BankAccount(String n, int no, String t, double b) {
        name = n;
        number = no;
        type = t;
        balance = b;
    }

    void deposit(double amt) {
        balance += amt;
    }

    void withdraw(double amt) {
        if (amt > balance)
            System.out.println("Insufficient Balance");
        else
            balance -= amt;
    }

    void balanceEnquiry() {
        System.out.println("Name: " + name);
        System.out.println("Account No: " + number);
        System.out.println("Type: " + type);
        System.out.println("Balance: " + balance);
    }

    public static void main(String[] args) {
        BankAccount a = new BankAccount("Ravi", 1001, "Savings", 10000);

        a.balanceEnquiry();
        a.deposit(5000);
        a.withdraw(3000);
        a.balanceEnquiry();
        a.withdraw(15000);
    }
}
